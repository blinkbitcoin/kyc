# access-token-demo: one mutation that mints a provider access token for the
# native SDK (mode 1).
PORT=4100

# mock   -> no credentials (the token is a mock-token-… string)
# sumsub -> the app token, secret key and webhook secret below
KYC_PROVIDER=mock

# Sumsub (KYC_PROVIDER=sumsub; see docs/integration/sumsub.md)
# SUMSUB_APP_TOKEN=<app token>
# SUMSUB_SECRET_KEY=<secret key>
# SUMSUB_WEBHOOK_SECRET=<webhook secret>
# The level a tier maps onto when the host's own table does not name one
# SUMSUB_LEVEL_NAME=basic-kyc-level
