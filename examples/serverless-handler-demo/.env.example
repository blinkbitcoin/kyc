# serverless-handler-demo: the package's access-token preset behind a route.
PORT=5106

# mock   -> no credentials (the token is a mock-token-… string)
# sumsub -> the app token and secret key below (no webhook: nothing to verify)
KYC_PROVIDER=mock

# Sumsub (KYC_PROVIDER=sumsub; see docs/integration/sumsub.md)
# SUMSUB_APP_TOKEN=<app token>
# SUMSUB_SECRET_KEY=<secret key>
# The level minted unless the request names one - the name configured in
# YOUR Sumsub dashboard (they differ per account)
# SUMSUB_LEVEL_NAME=basic-kyc-level
