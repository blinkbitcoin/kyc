# Root-level env (loaded by direnv via .envrc; copy to .env, gitignored).
# Backend variables live in examples/full-service-demo/.env.example - this file only carries
# the demo apps' bundle-time mode switches.

# Verification mode for the React Native demo (inlined when Metro bundles):
# native (default) | hosted | proxy | fake-native
# KYC_MODE=hosted

# Same for the web demo (Vite): hosted (default) | proxy
# VITE_KYC_MODE=proxy

# The port block: every service listens on KYC_PORT_BASE + its offset
# (scripts/lib/ports.mjs; `make ports` lists them). A linked worktree claims
# its own block automatically into .env.local (gitignored) - set the variable
# here or in the shell only to pick a block by hand.
# KYC_PORT_BASE=5300
