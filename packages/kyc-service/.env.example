# Every variable the kyc service reads. The contract is identical on every
# target - container, Kubernetes, Vercel, Cloudflare - except the three marked
# CONTAINER ONLY. The service refuses to start (listing every problem at once,
# with the capabilities that are on) when this file is incomplete.

# --- Capabilities --------------------------------------------------------
# Access tokens (POST /verification/token, GET /health) are always on.
# DATABASE_URL adds sessions: the GraphQL API, GET /hosted/:sessionId,
# POST /webhook/kyc/:provider and the Postgres store. Leave it unset for a
# tokens-only deployment - no connection is opened, no PUBLIC_BASE_URL and
# no webhook secret are needed. Apply the schema once per database:
# `node dist/node.js migrate`.
DATABASE_URL=postgresql://dev:dev@localhost:5432/kyc

# Public base URL of this backend, needed once sessions are on. The hosted
# page URL handed to clients is <PUBLIC_BASE_URL>/hosted/<sessionId>, and its
# origin is the allowedOrigin clients pin postMessage to. Must be an absolute
# http(s) URL; the service refuses to start without it (the local-origin
# default applies to ALLOW_INSECURE_DEV=true only).
PUBLIC_BASE_URL=http://localhost:5100

# --- Session verification (pick one) -------------------------------------
# The caller's bearer token becomes the user id the token is minted for and
# the session is owned by (the provider's external user id). Either a remote
# key set (RS/ES) ...
# SESSION_JWKS_URL=https://id.example.com/.well-known/jwks.json
# SESSION_ISSUER=https://id.example.com
# SESSION_AUDIENCE=kyc
# SESSION_USER_CLAIM=sub                # default: sub
# ... or a shared HS256 secret (JWT_SECRET is an accepted alias):
# SESSION_HS256_SECRET=change-me
# With neither, the service refuses to boot unless you opt into the dev
# passthrough below.

# --- Provider ------------------------------------------------------------
# 'mock' (default) for development and testing without Sumsub credentials,
# 'sumsub' for the real integration. The mock provider signs its own
# webhooks, so it requires ALLOW_INSECURE_DEV=true.
KYC_PROVIDER=mock
# A .env copied from this file will refuse to boot as-is: either uncomment
# ALLOW_INSECURE_DEV=true below (local dev with the mock provider) or switch
# to a real provider and configure its secrets.

# Sumsub configuration (required when KYC_PROVIDER=sumsub; app-token auth -
# docs/integration/sumsub.md; `make sumsub-env` writes a live .env)
# SUMSUB_APP_TOKEN=<app token>          # the mint needs this
# SUMSUB_SECRET_KEY=<secret key>        # the mint needs this
# SUMSUB_WEBHOOK_SECRET=<webhook secret key>   # sessions only
# The digest algorithm registered on the webhook; only the live test signs
# with it (the server reads the algorithm from the request header)
# SUMSUB_WEBHOOK_DIGEST_ALG=HMAC_SHA256_HEX
# SUMSUB_BASE_URL=https://api.sumsub.com
# Level applied when the token or session input omits levelName
# SUMSUB_LEVEL_NAME=basic-kyc-level
# Access-token lifetime in seconds (default 600)
# SUMSUB_TOKEN_TTL_SECS=600
# Ceiling on a single Sumsub HTTP call in ms, retries excluded (default 10000)
# SUMSUB_REQUEST_TIMEOUT_MS=10000

# Key the mock provider signs its own webhook with (X-Mock-Signature).
# Only used when KYC_PROVIDER=mock; defaults to "mock".
# MOCK_WEBHOOK_SECRET=mock

# --- Deployment ----------------------------------------------------------
# Declares this deployment production (never NODE_ENV, which every image
# sets): the mock provider and a sandbox (sbx:) Sumsub token are then
# refused at boot, and GraphQL introspection is off.
# KYC_ENV=production
# KYC_ALLOW_DEMO=true                   # the one bypass, for a staging deployment

# Browser origins allowed to call the token mint and the GraphQL API. Empty
# means same-origin only.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# --- Container only ------------------------------------------------------
# A function relies on its platform for the port, the proxy and the limits.
PORT=5100
# TRUST_PROXY=true                      # take the client from x-forwarded-for
# RATE_LIMIT_TOKEN_PER_MIN=60           # 0 switches a route's limit off
# RATE_LIMIT_HOSTED_PER_MIN=60
# RATE_LIMIT_WEBHOOK_PER_MIN=120
# RATE_LIMIT_GRAPHQL_PER_MIN=100

# --- Local development ---------------------------------------------------
# The explicit opt-in to running without session verification (the bearer
# token IS the user id) and without webhook signatures. NEVER in production.
# ALLOW_INSECURE_DEV=true

# --- Observability (OpenTelemetry, all optional - off unless set) ---------
# Standard OTEL_* vars; works with any OTLP backend (collector, Tempo, Honeycomb, Jaeger).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=kyc-service
# Local debugging without a collector: print spans to stdout
# OTEL_TRACES_EXPORTER=console
