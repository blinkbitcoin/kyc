# Live Sumsub layout for examples/full-service-demo/.env - what `make sumsub-env`
# writes (repo root). The non-secret values are Blink's SANDBOX (never
# production) as used by the first live pass (docs/integration/sumsub-lessons.md);
# the three secrets are DUMMY here - take the real ones from the team secret
# manager, item "kyc-library sandbox (Sumsub)", or generate your own dedicated
# App Token + webhook in the sandbox (.claude/skills/sumsub-sandbox-setup).
# Never commit the filled-in .env (gitignored, mode 600).
PORT=5100
DATABASE_URL=postgresql://dev:dev@localhost:5432/kyc

# Local dev: no JWT_SECRET, so the bearer token IS the user id (what the live
# tests and the demos send). Production: set JWT_SECRET and drop ALLOW_INSECURE_DEV.
ALLOW_INSECURE_DEV=true
# JWT_SECRET=9f2c6b1e4d8a7c3f5e0b2a9d6c4f8e1a

KYC_PROVIDER=sumsub
# Dev space -> App Tokens (sandbox tokens start with "sbx:"; the secret is shown once)
SUMSUB_APP_TOKEN=sbx:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SUMSUB_SECRET_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
# Dev space -> Webhooks -> your webhook's secret key and signature algorithm
SUMSUB_WEBHOOK_SECRET=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
SUMSUB_WEBHOOK_DIGEST_ALG=HMAC_SHA256_HEX
# Blink's sandbox level with an ID document, liveness and geolocation
SUMSUB_LEVEL_NAME=01-upgrade-to-level-TWO
SUMSUB_BASE_URL=https://api.sumsub.com
# The access-token example's tiers, mapped onto this sandbox's levels
KYC_LEVEL_BASIC=01-upgrade-to-level-TWO
KYC_LEVEL_ENHANCED=02-blink-debit-card-kyc

# Where the hosted page and the webhook are reachable. The automated tier
# never needs a public URL; the device matrix does (tailscale funnel --bg 5100)
PUBLIC_BASE_URL=http://localhost:5100
# The web demo's origin, for the browser rows of the device matrix
CORS_ALLOWED_ORIGINS=http://localhost:5101
